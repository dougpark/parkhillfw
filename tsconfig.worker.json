{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "types": ["bun", "@cloudflare/workers-types"]
  },
  "include": [
    "index.ts",
    "src/index.ts",
    "src/db/**/*.ts",
    "src/middleware/**/*.ts",
    "src/lib/auth.ts",
    "src/lib/auth.test.ts",
    "src/lib/email.ts",
    "src/lib/settings.ts",
    "src/lib/stripe.ts",
    "src/lib/product-catalog.ts",
    "src/lib/directory-reminder.test.ts",
    "src/lib/markdown-tags.test.ts",
    "scripts/**/*.ts",
    "drizzle.config.ts"
  ]
}
