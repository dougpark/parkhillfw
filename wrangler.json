{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "parkhillfw",
	"account_id": "aced30206a1e4ebd1813b3746776b609",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-01",
    "routes": [
    { "pattern": "parkhillfw.org", "custom_domain": true },
    { "pattern": "www.parkhillfw.org", "custom_domain": true }
  ],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "parkhillfw-db",
			"database_id": "e707738a-20a7-4332-9135-d3ca5d1f489d",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "parkhillfw-bucket"
		}
	],
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	]
}