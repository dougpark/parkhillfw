{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parkhillfw",
  "account_id": "aced30206a1e4ebd1813b3746776b609",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parkhillfw-db-dev",
      "database_id": "5198fab4-36d4-44ad-9358-69a6bfb49159",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "parkhillfw-bucket-dev"
    }
  ],
  "vars": {
    "STRIPE_PRICE_REGULAR_ANNUAL": "price_1UJdlALC1nxElUbWJU7cyGLM",
    "STRIPE_PRICE_PACESETTER_ANNUAL": "price_1UJdpkLC1nxElUbWVWdBg0GW",
    "STRIPE_PRICE_SECURITY_ANNUAL": "price_1UJdqCLC1nxElUbWh3QMilZ3",
    "STRIPE_PRICE_SECURITY_QUARTERLY": "price_1UJdqYLC1nxElUbWMyyVESKg"
  },
  "env": {
    "staging": {
      "name": "parkhillfw-staging",
      "routes": [
        { "pattern": "staging.parkhillfw.org", "custom_domain": true }
        ],
        "send_email": [
            {
            "name": "EMAIL",
            "remote": true
            }
        ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "parkhillfw-db-staging",
          "database_id": "1ec85740-4640-454b-83f7-86f6e75c1947",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "parkhillfw-bucket-staging"
        }
      ],
      "vars": {
        "STRIPE_PRICE_REGULAR_ANNUAL": "price_1UJdlALC1nxElUbWJU7cyGLM",
        "STRIPE_PRICE_PACESETTER_ANNUAL": "price_1UJdpkLC1nxElUbWVWdBg0GW",
        "STRIPE_PRICE_SECURITY_ANNUAL": "price_1UJdqCLC1nxElUbWh3QMilZ3",
        "STRIPE_PRICE_SECURITY_QUARTERLY": "price_1UJdqYLC1nxElUbWMyyVESKg"
      }
    },
    "production": {
      "name": "parkhillfw-prod",
      "routes": [
        { "pattern": "parkhillfw.org", "custom_domain": true },
        { "pattern": "www.parkhillfw.org", "custom_domain": true }
      ],
      "send_email": [
            {
            "name": "EMAIL",
            "remote": true
            }
        ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "parkhillfw-db",
          "database_id": "e707738a-20a7-4332-9135-d3ca5d1f489d",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "parkhillfw-bucket"
        }
      ],
      "vars": {
        "STRIPE_PRICE_REGULAR_ANNUAL": "REPLACE_WITH_LIVE_MODE_PRICE_ID",
        "STRIPE_PRICE_PACESETTER_ANNUAL": "REPLACE_WITH_LIVE_MODE_PRICE_ID",
        "STRIPE_PRICE_SECURITY_ANNUAL": "REPLACE_WITH_LIVE_MODE_PRICE_ID",
        "STRIPE_PRICE_SECURITY_QUARTERLY": "REPLACE_WITH_LIVE_MODE_PRICE_ID"
      }
    }
  }
}